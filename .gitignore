# ── Python 运行产物 ──
__pycache__/
*.py[cod]
*.pyo
*.spec

# ── 打包中间产物 ──
build/
dist/

# ── 可执行文件：通过 GitHub Releases 分发，不入库 ──
*.exe

# ── 虚拟环境 ──
.venv/
venv/
env/

# ── 运行时生成的个人数据（严禁提交） ──
# 任务数据、笔记、用户配置
V1.0/data.json
V1.0/notes.txt
V1.0/config.json
V1.0/清单备份/

# ── Excel 数据表：仅保留脱敏示例，其余一律忽略 ──
V1.0/工作任务/*.xlsx
V1.0/工作任务/*.xls
V1.0/工作任务/*.xlsm
!V1.0/工作任务/工作任务示例表.xlsx

# ── Excel 临时锁文件 ──
~$*

# ── 编辑器与系统文件 ──
.idea/
.vscode/
*.log
Thumbs.db
desktop.ini
.DS_Store
